<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteBase /

    # Existing files/folders ko directly serve karo
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React/Vite SPA fallback
    RewriteRule ^ index.html [L]
</IfModule>