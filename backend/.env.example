# Copy to .env and fill in. NEVER commit .env
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
JWT_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# true = refuse to run billing/payment/stock flows without MongoDB transactions (needs replica set / Atlas).
# Defaults to true in production, false otherwise.
REQUIRE_TRANSACTIONS=false

# Used ONLY by `npm test` (integration tests). Must be a throw-away database.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/jewellery_erp_test
